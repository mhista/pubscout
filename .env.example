NEXT_PUBLIC_SITE_URL=https://pubscout.dev

# --- GitHub (stars, issues, contributors) -----------------------------------
# Fine-grained token with "Public repositories (read-only)" and no other permissions.
# Raises GitHub's limit from 60 to 5,000 requests an hour. See README "GitHub token".
GITHUB_TOKEN=

# --- AI summaries + categories (any one is enough; all are free tiers) --------
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq:   https://console.groq.com/keys
GROQ_API_KEY=
# Optional, paid:
ANTHROPIC_API_KEY=

# Order to try them in. When one hits its limit, the next one takes over.
AI_PROVIDERS=gemini,groq,anthropic

# Models per provider, tried in order, as model@requests-per-minute.
# Defaults shown; check your real limits in each console and adjust.
# GEMINI_MODELS=gemini-3.8-flash@5,gemini-3.5-flash-lite@10
# GROQ_MODELS=openai/gpt-oss-120b@3,openai/gpt-oss-20b@4
# ANTHROPIC_MODELS=claude-haiku-5-5@40

# When to write a fresh summary for a package that already has one:
# major (default) = only on breaking releases, never = once per package, every = each new version
AI_REFRESH=major

# "Describe what you need" search uses Gemini embeddings (free, same key) and a fast model to pick.
# EMBED_MODEL=gemini-embedding-001
# SEARCH_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# SEARCH_GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# How many top packages to sync (pub.dev's own ranking order).
SYNC_LIMIT=2000
# A package synced within this many hours is skipped, so a stopped sync resumes where it left off (default 12)
# SYNC_FRESH_HOURS=12
# Parallel downloads during sync (default 6)
# SYNC_WORKERS=6

# --- Site (Vercel) ---
# Package requests: fine-grained GitHub token (this repo only, Issues: read & write) + the repo
# GH_REQUEST_TOKEN=
# GH_REPO=mhista/pubscout
# Support button (Buy Me a Coffee, Ko-fi, GitHub Sponsors...). Hidden when empty.
# NEXT_PUBLIC_SUPPORT_URL=https://buymeacoffee.com/your-name
# Packages out of the top list longer than this are dropped from the catalog (default 30)
# STALE_DAYS=30
